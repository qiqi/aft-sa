# Built PDFs (final & intermediate). Both documents are ~17 MB, so every
# rebuild would add that again to history; they are regenerable from the tex
# and the tracked figs/, and were untracked as of Aug 2026. Earlier revisions
# remain in history -- those are stale and should not be trusted to match the
# sources; build them instead.
sa-ai.pdf
whitepaper.pdf

# Figure archives only -- figs/ itself is TRACKED (every figure the tex
# includes must be in git; the blanket figs/ ignore caused three review
# majors: P11-M2, P12-M7, P13-M1)
figs_archive_*/
figs_pre_recalib/

# Python build artifacts
__pycache__/
*.pyc

# Backups
*.bak_*
*.bak

# Auxiliary PDFs not from main build
eppler.pdf
nlf.pdf

# Rendered page images for the Somers Fig. 9 digitization: regenerable from
# references/somers1981-*.pdf with `python3 repro/cfd/digitize_somers_fig9.py --render`.
repro/cfd/.somers_fig9/
